# Environment Variables for Backend

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL for CORS (update for production)
FRONTEND_URL=http://localhost:5173

# SMTP Configuration (Gmail example)
# For Gmail: use smtp.gmail.com, port 587, and an App Password
# To create Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Recipient Email
EMAIL_TO=contactus@supremusllc.biz
